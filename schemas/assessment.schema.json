{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ya-yara/codex-watchtower/schemas/assessment.schema.json",
  "title": "WatchtowerAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "current_action", "goal_alignment", "evidence", "basis_ids", "concerns", "needs_attention", "recommended_human_action", "confidence", "assessed_by", "escalation_reason", "event_cursor", "assessed_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "enum": ["progressing", "investigating", "between_turns", "waiting", "stalled", "looping", "off_scope", "terminal_completed", "terminal_completed_unconfirmed", "terminal_failed", "unknown"] },
    "current_action": { "type": "string", "minLength": 1, "maxLength": 500 },
    "goal_alignment": { "enum": ["aligned", "possibly_aligned", "misaligned", "unknown"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "basis_ids": {
      "description": "Evidence refs supporting status, current_action, and goal_alignment; validated semantically against evidence[].ref_id.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "concerns": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "kind", "explanation", "evidence_refs"],
        "properties": {
          "severity": { "enum": ["info", "warning", "critical"] },
          "kind": { "enum": ["loop", "stagnation", "scope", "tests", "errors", "waiting", "resource", "uncertainty", "infrastructure", "other"] },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "needs_attention": { "type": "boolean" },
    "recommended_human_action": { "type": ["string", "null"], "maxLength": 1000 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "assessed_by": { "enum": ["luna", "terra", "rules"] },
    "escalation_reason": { "type": ["string", "null"], "maxLength": 500 },
    "event_cursor": { "type": ["string", "null"] },
    "assessed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_type", "ref_id", "claim"],
      "properties": {
        "ref_type": { "enum": ["event", "signal", "system"] },
        "ref_id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
